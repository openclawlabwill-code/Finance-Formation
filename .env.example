# Copier ce fichier en ".env" puis adapter.
PORT=3000
# 127.0.0.1 = accessible uniquement depuis ce Mac (recommandé).
HOST=127.0.0.1
# Code INSEE de la région par défaut (52 = Pays de la Loire).
REGION_PAR_DEFAUT=52
# Token exigé par l'API de mise à jour (agent Hermes). Vide = API de mise à jour désactivée.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=
# true = les propositions de l'agent sont publiées sans validation humaine (déconseillé).
AUTO_PUBLISH=false
