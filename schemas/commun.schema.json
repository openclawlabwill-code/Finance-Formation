{
  "$id": "commun.json",
  "definitions": {
    "codeRegion": { "type": "string", "pattern": "^(0[1-6]|[1-9][0-9])$" },
    "regionOuNational": { "type": "string", "pattern": "^(national|0[1-6]|[1-9][0-9])$" },
    "identifiant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$" },
    "acteurRegional": {
      "enum": ["conseil_regional","transitions_pro","agefiph","cap_emploi","cma","cariforef","france_travail","missions_locales","dreets","opco","conseil_departemental"]
    },
    "statutFiche": { "enum": ["actif","modifie","supprime","a_verifier"] },
    "source": {
      "type": "object",
      "required": ["url","intitule","organisme"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "intitule": { "type": "string", "minLength": 3 },
        "organisme": { "type": "string", "minLength": 2 },
        "date_consultation": { "type": "string", "format": "date" }
      }
    },
    "condition": {
      "type": "object",
      "required": ["attribut","operateur","valeurs"],
      "additionalProperties": false,
      "properties": {
        "attribut": { "type": "string", "pattern": "^[a-z_0-9]+$" },
        "operateur": { "enum": ["in","not_in"] },
        "valeurs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
