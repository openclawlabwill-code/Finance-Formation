{
  "$id": "attributs.json",
  "type": "object",
  "required": ["version","attributs"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "attributs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id","label","valeurs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_0-9]+$" },
          "label": { "type": "string" },
          "valeurs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id","label"],
              "additionalProperties": false,
              "properties": { "id": { "type": "string" }, "label": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
