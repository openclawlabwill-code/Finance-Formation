{
  "$id": "proposition.json",
  "type": "object",
  "required": ["region","action","sources"],
  "additionalProperties": false,
  "properties": {
    "agent": { "type": "string" },
    "region": { "$ref": "commun.json#/definitions/regionOuNational" },
    "action": { "enum": ["creation","modification","suppression","actualite"] },
    "dispositif_id": { "$ref": "commun.json#/definitions/identifiant" },
    "contenu": { "type": "object" },
    "motif": { "type": "string", "minLength": 5 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url","intitule","organisme","extrait"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "intitule": { "type": "string", "minLength": 3 },
          "organisme": { "type": "string", "minLength": 2 },
          "extrait": { "type": "string", "minLength": 10 },
          "date_consultation": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "action": { "enum": ["creation","modification","suppression"] } } },
      "then": { "required": ["dispositif_id"] } },
    { "if": { "properties": { "action": { "enum": ["creation","modification","actualite"] } } },
      "then": { "required": ["contenu"] } }
  ]
}
